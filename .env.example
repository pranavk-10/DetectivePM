# Copy to .env for local work. Never commit real values.

# development or production. Production refuses SQLite and demo data.
ENVIRONMENT=development

# PostgreSQL in production. postgres:// and postgresql:// URLs both work.
# Without this, local development uses backend/local.db (SQLite).
DATABASE_URL=

# Used for CORS and documentation.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Required in production. Unlocks manual runs, review and other admin actions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Optional: Adzuna India (free key at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: Google Sheets. Paste the service-account JSON as one line, and share
# the sheet with that account's email address.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional operational settings
# RUN_SCHEDULER_IN_API=true    # run the schedule inside the API when no worker exists
# MANUAL_RUN_COOLDOWN_SECONDS=300
# SHOW_DEMO_DATA=false         # development only

# Frontend (set on Vercel at build time): where /api requests are forwarded.
# BACKEND_URL=https://your-api.example.com
